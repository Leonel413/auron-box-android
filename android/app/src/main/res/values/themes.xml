<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AuronBox" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/preto</item>
        <item name="colorPrimaryVariant">@color/preto</item>
        <item name="colorOnPrimary">@color/branco</item>
        <item name="colorSecondary">@color/preto</item>
        <item name="colorSecondaryVariant">@color/preto</item>
        <item name="colorOnSecondary">@color/branco</item>
        <item name="colorError">@color/perigo</item>
        <item name="android:windowBackground">@color/branco</item>
        <item name="android:statusBarColor">@color/branco</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorPrimary">@color/preto</item>
        <item name="android:textColorSecondary">@color/cinza_texto</item>
        <item name="shapeAppearanceSmallComponent">@style/Forma.Reta</item>
        <item name="shapeAppearanceMediumComponent">@style/Forma.Reta</item>
        <item name="shapeAppearanceLargeComponent">@style/Forma.Reta</item>
        <item name="materialButtonStyle">@style/BotaoPadrao</item>
        <item name="textInputStyle">@style/CampoTexto</item>
    </style>

    <style name="Forma.Reta" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <style name="BotaoPadrao" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/cinza_claro</item>
        <item name="strokeColor">@color/cinza_borda</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:textColor">@color/preto</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="BotaoPrimario" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/preto</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:textColor">@color/branco</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <style name="BotaoPerigo" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/perigo</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:textColor">@color/perigo</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="CampoTexto" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/preto</item>
        <item name="hintTextColor">@color/preto</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
    </style>

    <style name="CampoDropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/preto</item>
        <item name="hintTextColor">@color/preto</item>
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
    </style>

    <style name="ChipCategoria" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_fundo</item>
        <item name="chipStrokeColor">@color/cinza_borda</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/chip_texto</item>
    </style>

    <style name="TextoTitulo">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/preto</item>
    </style>

    <style name="TextoNormal">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/preto</item>
    </style>

    <style name="TextoRotulo">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/cinza_texto</item>
    </style>

    <style name="TextoValor">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/preto</item>
    </style>

    <style name="TextoPreco">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/preto</item>
    </style>

    <style name="Divisor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/cinza_linha</item>
    </style>
</resources>
