<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_borda"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView style="@style/TextoRotulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/data_pedido" />
    <TextView android:id="@+id/data" style="@style/TextoValor" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView style="@style/TextoRotulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/numero_pedido" />
    <TextView android:id="@+id/numero" style="@style/TextoValor" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView style="@style/TextoRotulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/status_pedido" />
    <TextView android:id="@+id/status" style="@style/TextoPreco" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <TextView style="@style/TextoRotulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/valor_pedido" />
    <TextView android:id="@+id/valor" style="@style/TextoValor" android:layout_width="match_parent" android:layout_height="wrap_content" />

    <Button
        android:id="@+id/btnDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/ver_detalhamento" />
</LinearLayout>
