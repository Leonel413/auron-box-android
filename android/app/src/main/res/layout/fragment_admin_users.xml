<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/buscar_por_email">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionSearch"
                        android:inputType="textEmailAddress" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnBuscar"
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="5dp"
                    android:text="@string/buscar" />
            </LinearLayout>

            <TextView
                android:id="@+id/erro"
                style="@style/TextoValor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="@color/perigo"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_borda"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView android:id="@+id/nome" style="@style/TextoValor" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/emailUsuario" style="@style/TextoValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/codigoUsuario" style="@style/TextoValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                <TextView android:id="@+id/adminUsuario" style="@style/TextoValor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />

                <View style="@style/Divisor" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" />

                <TextView
                    style="@style/TextoValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/info_senha_sistema" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/senha_sistema"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/senhaSistema"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword" />
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnPromover"
                    style="@style/BotaoPrimario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/tornar_admin" />

                <Button
                    android:id="@+id/btnRemover"
                    style="@style/BotaoPerigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/remover_admin" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/preto"
        android:visibility="gone" />
</FrameLayout>
